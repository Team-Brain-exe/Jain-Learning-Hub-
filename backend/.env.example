# JAIN Learning Hub Backend Environment Variables Example
# Copy this file to .env and configure values for your environment.
# NEVER commit .env or app passwords to version control.

# Frontend application base URL for generating faculty consent review deep links
# Format: http://localhost:5173 (dev) or https://hub.jainuniversity.ac.in (prod)
FRONTEND_BASE_URL=http://localhost:5173

# SMTP Server Configuration (Gmail App Password, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# JWT Authentication
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# Database Configuration (defaults to SQLite if unset)
# DATABASE_URL=sqlite:///./sql_app.db

# Object Storage Configuration (local signed storage by default)
STORAGE_SIGNING_SECRET=
STORAGE_LOCAL_DIR=./storage_objects
STORAGE_BASE_URL=http://localhost:8000
STORAGE_URL_EXPIRY_SECONDS=3600
